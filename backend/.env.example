# NetGuard local MVP backend configuration (copy to .env and adjust)

APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO

# Postgres (docker-compose) - comment out to use the local SQLite fallback
# DATABASE_URL=postgresql+psycopg://netguard:netguard@localhost:5432/netguard

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Scanner behaviour
SCAN_CONCURRENCY=64
CONNECT_TIMEOUT=1.5
POLL_INTERVAL=2.0
TARGET_RATE_LIMIT=150

# Authorization guardrails
ALLOW_PRIVATE_TARGETS=true
ALLOW_LOCALHOST=true
# Extra authorized CIDRs (comma-separated) if you must scan beyond private ranges
TARGET_ALLOWLIST=
MAX_HOSTS_PER_SCAN=4096
MAX_PORTS_PER_SCAN=2000
